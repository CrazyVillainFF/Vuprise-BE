PORT=5000
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/nexora?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
PASSWORD_RESET_PEPPER=replace_with_a_different_long_random_secret
JWT_EXPIRE=30d
CLIENT_URL=http://localhost:5173
# Comma-separated extra browser origins allowed by CORS, in addition to CLIENT_URL.
ALLOWED_CLIENT_ORIGINS=
# Comma-separated emails allowed to open the admin console.
ADMIN_EMAILS=
NODE_ENV=development
SEED_DEMO_DATA=false
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Password recovery is sent server-side through Brevo's transactional email HTTP API.
BREVO_API_KEY=your_brevo_api_key
PASSWORD_RESET_FROM=vupriseofficial@gmail.com

# Cloudinary Storage for Production Image Uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
