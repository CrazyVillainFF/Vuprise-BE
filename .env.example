PORT=5000
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/nexora?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
PASSWORD_RESET_PEPPER=replace_with_a_different_long_random_secret
JWT_EXPIRE=30d
CLIENT_URL=http://localhost:5173
# Comma-separated extra browser origins allowed by CORS, in addition to CLIENT_URL.
ALLOWED_CLIENT_ORIGINS=
# Comma-separated emails allowed to open the admin console.
ADMIN_EMAILS=
NODE_ENV=development
SEED_DEMO_DATA=false
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Password recovery, admin email, support replies, and inactivity reminders are
# sent server-side through Brevo's transactional email HTTP API. BREVO_SENDER_EMAIL
# must be a verified sender in Brevo; BREVO_SENDER_NAME is its display name.
# Deployments that still define PASSWORD_RESET_FROM keep working: it is used as
# the sender-email fallback when BREVO_SENDER_EMAIL is not set.
# Leave BREVO_API_KEY blank until you have an API key from Brevo; email features
# stay disabled and report a clear setup message until then.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Vuprise

# Cloudinary Storage for Production Image Uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Vuprise AI chat. The backend proxies an OpenCode server; the browser never
# talks to it directly. The server must be able to reach OPENCODE_BASE_URL: on
# a managed host (Render) the 127.0.0.1 default only works when an OpenCode
# server runs inside the same container - otherwise every AI request answers
# 503. See docs/production-feature-setup.md. Keep OpenCode bound to localhost
# or a private network - never expose it to the public internet without
# OPENCODE_SERVER_PASSWORD.
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_MODEL_PROVIDER=opencode
OPENCODE_MODEL_ID=deepseek-v4.1-flash-free
AI_CHAT_TIMEOUT_MS=90000
# Optional HTTP basic auth for a protected OpenCode server (opencode serve).
OPENCODE_SERVER_PASSWORD=
OPENCODE_SERVER_USERNAME=opencode

# Vuprise AI image generation (optional). Uses any OpenAI-compatible Images
# API: the backend calls POST {AI_IMAGE_API_URL}/images/generations with
# { model, prompt, size, n } and reads { data: [{ url }] } or
# { data: [{ b64_json }] }. Credentials stay server-side; leave AI_IMAGE_API_URL
# and AI_IMAGE_API_KEY blank to keep image generation disabled.
# Example (OpenAI): AI_IMAGE_API_URL=https://api.openai.com/v1 and
# AI_IMAGE_MODEL=gpt-image-1 (GPT image models always return b64_json).
AI_IMAGE_API_URL=
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=gpt-image-1
